# =====================================================================
# NEXORA — Environment Configuration Example
# Copy to .env and fill in real values. Never commit the real .env file.
# =====================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------
# PostgreSQL (shared by core-api via Prisma; pgvector enabled for future AI phases)
# ---------------------------------------------------------------------
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_DB=nexora
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexora:nexora_dev_password@localhost:5432/nexora?schema=public

# ---------------------------------------------------------------------
# Redis (cache, rate limiting, queues, sessions)
# ---------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------
# NEXORA Core API (Node.js / NestJS)
# ---------------------------------------------------------------------
CORE_API_PORT=4000
CORE_API_URL=http://localhost:4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# JWT — access & refresh tokens (platform + organisation auth foundation)
# Generate real secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------
# NEXORA Control Center (Next.js — web app)
# ---------------------------------------------------------------------
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000
CONTROL_CENTER_PORT=3000

# ---------------------------------------------------------------------
# NEXORA Organisation Desktop (Tauri — points at the same Core API)
# ---------------------------------------------------------------------
VITE_CORE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------
# NEXORA AI Service (Python / FastAPI) — configured from Phase 7 onward
# ---------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# AI_MODEL_PROVIDER=openai|anthropic|local
# AI_MODEL_PROVIDER_API_KEY=

# ---------------------------------------------------------------------
# Object Storage (S3-compatible — configured from Phase 5/6 onward)
# ---------------------------------------------------------------------
# OBJECT_STORAGE_PROVIDER=s3|r2|azure-blob
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------
# Payment / Banking Providers (configured from Phase 6 onward — sandbox first)
# ---------------------------------------------------------------------
# PAYMENT_PROVIDER=sandbox
# PAYMENT_PROVIDER_PUBLIC_KEY=
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Email / SMS Providers (configured from Phase 2/4 onward)
# ---------------------------------------------------------------------
# EMAIL_PROVIDER=sandbox
# EMAIL_FROM_ADDRESS=no-reply@nexora.sapoktech.com
# SMS_PROVIDER=sandbox
