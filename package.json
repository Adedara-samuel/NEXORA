{
  "name": "nexora",
  "private": true,
  "version": "0.1.0",
  "description": "NEXORA — enterprise multi-tenant organisational management platform (SAPOK TECH)",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:up:all": "docker compose up -d",
    "core-api:dev": "pnpm --filter @nexora/core-api dev",
    "core-api:prisma:generate": "pnpm --filter @nexora/core-api prisma:generate",
    "core-api:prisma:migrate": "pnpm --filter @nexora/core-api prisma:migrate",
    "core-api:prisma:seed": "pnpm --filter @nexora/core-api prisma:seed",
    "control-center:dev": "pnpm --filter @nexora/control-center dev"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
