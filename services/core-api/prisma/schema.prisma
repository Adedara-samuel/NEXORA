// NEXORA Core API — Prisma schema
//
// Phase 1 (Foundation): auth foundation + audit logging.
//   - PlatformUser   : identity for NEXORA Control Center operators.
//   - RefreshToken   : hashed, rotating refresh tokens for both auth scopes
//                      (platform now; organisation from Phase 4 onward).
//   - AuditLog       : generic append-only audit trail (section 58), used
//                      from the very first login event onward.
//
// Phase 2 (this change): platform RBAC + organisation management/onboarding.
//   - PlatformPermission / PlatformRole / PlatformRolePermission /
//     PlatformUserRole : the RBAC join promised in Phase 1 — permissions are
//     grouped into roles, roles are assigned to platform users (many-to-many
//     both ways, so a user can hold more than one role).
//   - Organisation    : the platform-managed shell record created during
//     onboarding. Subscriptions/billing (Phase 3) and organisation-side
//     auth/admin (Phase 4) attach to this later — this phase only owns
//     identity + lifecycle status.
//
// Phase 3 (this change): module + subscription engine.
//   - Module / PlanModule : a fixed catalog of feature modules (the business
//     modules Phase 5 actually builds — employees, payroll, etc.) and which
//     Plans include which modules. The catalog is seeded, not user-created,
//     since entries must correspond to real built features.
//   - Plan                : a purchasable tier (price + billing cycle +
//     included modules).
//   - Subscription        : one per Organisation, tracks the paid period and
//     lifecycle (TRIALING/ACTIVE → GRACE_PERIOD → SUSPENDED, or CANCELLED).
//     Status is stored but re-derived from dates on every read (see
//     SubscriptionsService.deriveEffectiveStatus) — there's no scheduler yet
//     to flip it automatically, so reads self-heal it instead.
//   - Invoice             : one per billing cycle charge attempt; a PAID
//     invoice doubles as the receipt (see Invoice.receiptNumber).
//   - Payments run through a swappable PaymentGateway interface — only a
//     MockPaymentGateway exists until the real integration is built.
//
// Phase 4 (this change): organisation platform — org-side auth & admin.
//   - OrganisationUser : identity for users inside a tenant organisation.
//     Email is unique per-organisation, not globally (@@unique([organisationId, email])),
//     so login requires the organisation's slug + email + password, not
//     email alone — see AuthController.organisationLogin.
//   - OrganisationPermission / OrganisationRole / OrganisationRolePermission /
//     OrganisationUserRole : the exact same RBAC shape as the platform side
//     (Phase 2), but every role is scoped to one organisation
//     (@@unique([organisationId, name])) — tenants define their own roles,
//     they don't share a global catalog like platform roles do.
//   - Every org-scoped OrganisationsRbacModule/OrganisationUsersModule/
//     DepartmentsModule/BranchesModule endpoint derives organisationId from
//     the caller's own JWT (@CurrentOrganisationId()), never from a URL
//     param — that's the tenant-isolation boundary. The one exception is
//     provisioning an organisation's first admin account
//     (POST /organisations/:id/admin), which is platform-initiated by
//     design (no org user exists yet to self-serve with).
//   - Department / Branch : simple org-structure entities an OrganisationUser
//     can belong to.
//
// Phase 5 (this change, first slice — Employees): business modules.
//   - Employee : an HR record, deliberately SEPARATE from OrganisationUser —
//     not every employee has (or needs) a login account, and not every
//     OrganisationUser is necessarily an employee (could be a contractor
//     with admin access, etc.). `organisationUserId` is an optional link
//     for the case where an employee also has system access.
//   - Attendance / Leave / Documents / Compliance / Payroll are the
//     remaining Phase 5 sub-modules — not built yet, each needs Employee to
//     exist first, which is why it's the first slice.
//
// Every later phase ADDS models here — this file is never treated as final.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthScope {
  PLATFORM
  ORGANISATION
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum OrganisationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  ANNUALLY
}

/// GRACE_PERIOD and SUSPENDED are derived from dates, not set directly by
/// the API — see SubscriptionsService.deriveEffectiveStatus.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum OrganisationUserStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model PlatformUser {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  firstName    String
  lastName     String
  status       PlatformUserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  refreshTokens         RefreshToken[]
  roles                 PlatformUserRole[]
  organisationsCreated  Organisation[]

  @@map("platform_users")
}

/// One platform-wide permission, e.g. "organisations:create". Permissions are
/// never assigned to users directly — only via a PlatformRole.
model PlatformPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  /// Groups permissions for UI display (e.g. "organisations", "platform_users").
  category    String
  createdAt   DateTime @default(now())

  roles PlatformRolePermission[]

  @@map("platform_permissions")
}

/// A named bundle of permissions assignable to platform users. isSystem roles
/// (seeded: SUPER_ADMIN, SUPPORT, FINANCE) can't be deleted via the API —
/// only their assignment to users changes.
model PlatformRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PlatformRolePermission[]
  users       PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformRolePermission {
  roleId       String
  permissionId String

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("platform_role_permissions")
}

model PlatformUserRole {
  platformUserId String
  roleId         String
  assignedAt     DateTime @default(now())

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  role         PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([platformUserId, roleId])
  @@map("platform_user_roles")
}

/// The platform-managed shell record for a tenant organisation, created
/// during onboarding. Deliberately thin at this phase — no subscription,
/// billing or org-admin-account fields here; those attach in Phase 3/4.
model Organisation {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  status       OrganisationStatus @default(PENDING)
  contactEmail String
  contactPhone String?
  industry     String?
  /// ISO 3166-1 alpha-2 country code — picks which TaxBand catalog applies
  /// to this organisation's payroll by default (see docs/phase-5-payroll.md).
  /// Only "NG" has seeded bands so far; any other country needs
  /// OrganisationTaxSettings.customBands set before payroll can run.
  countryCode  String             @default("NG")
  /// Set once this organisation has been provisioned as a Merchant in
  /// SAPOK Pay (see docs/phase-6-payroll-disbursement.md) — null until the
  /// first disbursement attempt. paymentProviderApiKey is stored in plain
  /// text: a known gap, needs an encryption-at-rest layer before this
  /// holds anything that matters in production.
  paymentProviderMerchantId String?
  paymentProviderApiKey     String?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy     PlatformUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  users         OrganisationUser[]
  roles         OrganisationRole[]
  departments   Department[]
  branches      Branch[]
  employees     Employee[]
  attendanceRecords Attendance[]
  leaveRequests LeaveRequest[]
  taxSettings   OrganisationTaxSettings?
  payrollRuns   PayrollRun[]
  payslips      Payslip[]
  documents     Document[]
  complianceRecords ComplianceRecord[]

  @@index([status])
  @@map("organisations")
}

/// A fixed catalog of feature modules — entries correspond 1:1 to real
/// business modules (Phase 5 onward), so this is seeded, not user-created.
model Module {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  plans PlanModule[]

  @@map("modules")
}

model Plan {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  /// Stored in minor currency units (e.g. kobo) to avoid float rounding.
  priceMinor   Int
  currency     String       @default("NGN")
  billingCycle BillingCycle
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanModule {
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

/// One per Organisation (1:1 — an org has exactly one subscription at a
/// time; changing plans updates this row rather than creating a new one).
model Subscription {
  id                 String             @id @default(uuid())
  organisationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  gracePeriodEndsAt  DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  invoices     Invoice[]

  @@map("subscriptions")
}

/// A PAID invoice doubles as the receipt — see receiptNumber/paidAt.
model Invoice {
  id               String        @id @default(uuid())
  subscriptionId   String
  organisationId   String
  receiptNumber    String        @unique
  amountMinor      Int
  currency         String
  status           InvoiceStatus @default(PENDING)
  periodStart      DateTime
  periodEnd        DateTime
  paymentReference String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([status])
  @@map("invoices")
}

/// Identity for users inside a tenant organisation. Email is unique
/// PER-ORGANISATION, not globally (@@unique([organisationId, email])) — two
/// different organisations can each have a "hr@company.com" user, so login
/// needs the organisation's slug + email + password, not email alone.
model OrganisationUser {
  id             String                 @id @default(uuid())
  organisationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  status         OrganisationUserStatus @default(ACTIVE)
  departmentId   String?
  branchId       String?
  lastLoginAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organisation  Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  department    Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch        Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roles         OrganisationUserRole[]
  refreshTokens RefreshToken[]
  employee      Employee?
  approvedLeaveRequests LeaveRequest[]
  uploadedDocuments Document[]

  @@unique([organisationId, email])
  @@index([organisationId])
  @@map("organisation_users")
}

/// The org-side RBAC catalog — same shape as PlatformPermission (Phase 2),
/// but fixed/seeded globally (permission keys are code-defined, checked by
/// @RequirePermissions(...) in every org-scoped controller — not something
/// a tenant can invent). What tenants DO define themselves is which
/// permissions each of their OWN roles gets (see OrganisationRole).
model OrganisationPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  category    String
  createdAt   DateTime @default(now())

  roles OrganisationRolePermission[]

  @@map("organisation_permissions")
}

/// Unlike PlatformRole (one global catalog), every OrganisationRole belongs
/// to exactly one Organisation (@@unique([organisationId, name])) — tenants
/// define their own roles from the shared OrganisationPermission catalog.
/// isSystem roles (seeded per-org on first use: SUPER_ADMIN) can't be
/// deleted via the API.
model OrganisationRole {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  permissions  OrganisationRolePermission[]
  users        OrganisationUserRole[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("organisation_roles")
}

model OrganisationRolePermission {
  roleId       String
  permissionId String

  role       OrganisationRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission OrganisationPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("organisation_role_permissions")
}

model OrganisationUserRole {
  organisationUserId String
  roleId             String
  assignedAt         DateTime @default(now())

  organisationUser OrganisationUser @relation(fields: [organisationUserId], references: [id], onDelete: Cascade)
  role             OrganisationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([organisationUserId, roleId])
  @@map("organisation_user_roles")
}

model Department {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        OrganisationUser[]
  employees    Employee[]

  @@unique([organisationId, name])
  @@map("departments")
}

model Branch {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users        OrganisationUser[]
  employees    Employee[]

  @@unique([organisationId, name])
  @@map("branches")
}

/// An HR record — deliberately separate from OrganisationUser (see Phase 5
/// header comment). employeeNumber is unique per-organisation, not globally.
model Employee {
  id                 String         @id @default(uuid())
  organisationId     String
  employeeNumber     String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  position           String?
  departmentId       String?
  branchId           String?
  organisationUserId String?        @unique
  status             EmployeeStatus @default(ACTIVE)
  hireDate           DateTime
  terminationDate    DateTime?
  /// Monthly base salary in minor currency units — nullable until payroll
  /// (later in Phase 5) actually needs it; not every employee record is
  /// created with salary info up front.
  salaryMinor        Int?
  currency           String         @default("NGN")
  /// Where payroll disbursement (Phase 6, SAPOK Pay integration) pays this
  /// employee's net salary — both null until set; an employee without
  /// these is skipped by disbursement the same way one without
  /// salaryMinor is skipped by payroll computation.
  bankAccountNumber  String?
  bankCode           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  organisationUser OrganisationUser? @relation(fields: [organisationUserId], references: [id], onDelete: SetNull)
  attendanceRecords Attendance[]
  leaveRequests     LeaveRequest[]
  payslips          Payslip[]
  documents         Document[]
  complianceRecords ComplianceRecord[]

  @@unique([organisationId, employeeNumber])
  @@index([organisationId])
  @@map("employees")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

/// One row per employee per calendar day. clockInAt/clockOutAt are optional —
/// a manually-entered ABSENT record has neither.
model Attendance {
  id             String           @id @default(uuid())
  organisationId String
  employeeId     String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  clockInAt      DateTime?
  clockOutAt     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([organisationId])
  @@map("attendance_records")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// approvedById references OrganisationUser (the account that actioned the
/// request), not Employee — an employee without system access can still be
/// the *subject* of a leave request, but only a logged-in user can approve one.
model LeaveRequest {
  id              String      @id @default(uuid())
  organisationId  String
  employeeId      String
  leaveType       LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  reason          String?
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy   OrganisationUser? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organisationId, employeeId])
  @@map("leave_requests")
}

/// Global, code-curated PAYE tax-band catalog per country — NOT
/// tenant-editable directly (see OrganisationTaxSettings for the per-org
/// override path). Only "NG" is seeded today, reflecting Nigeria's Tax Act
/// 2025 bands effective 2026-01-01: best-effort, not a substitute for
/// professional tax advice — verify against current FIRS guidance before
/// relying on this for real payroll. Thresholds are ANNUAL, in whole
/// currency units (not minor units) so the top band (₦50,000,000) fits an
/// Int32 column; `upToMajor: null` marks the open-ended top band.
model TaxBand {
  id          String  @id @default(uuid())
  countryCode String
  order       Int
  upToMajor   Int?
  ratePercent Int

  @@unique([countryCode, order])
  @@map("tax_bands")
}

/// Per-organisation override of the global TaxBand catalog — this is the
/// "every organisation can always correct theirs" mechanism. When
/// `customBands` is set it fully replaces the country default; otherwise
/// payroll falls back to TaxBand rows for Organisation.countryCode.
model OrganisationTaxSettings {
  id                  String   @id @default(uuid())
  organisationId      String   @unique
  /// [{ "upToMajor": number|null, "ratePercent": number }, ...] ascending, last entry upToMajor: null
  customBands         Json?
  /// Statutory employee pension contribution, whole percent. Null = use the
  /// platform default for the country (8% for Nigeria, Pension Reform Act).
  pensionRatePercent  Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("organisation_tax_settings")
}

enum PayrollRunStatus {
  COMPLETED
  CANCELLED
}

enum PayrollDisbursementStatus {
  NOT_DISBURSED
  DISBURSING
  DISBURSED
  PARTIALLY_DISBURSED
  FAILED
}

enum PayslipDisbursementStatus {
  PAID
  FAILED
  SKIPPED
}

/// One run per organisation per calendar month. Once COMPLETED a run's
/// payslips are immutable — correcting a mistake means CANCELLED + a fresh
/// run, never editing figures in place (same immutability principle as
/// SAPOK Pay's ledger).
model PayrollRun {
  id                   String           @id @default(uuid())
  organisationId       String
  periodYear           Int
  periodMonth          Int
  status               PayrollRunStatus @default(COMPLETED)
  currency             String           @default("NGN")
  totalGrossMinor      Int              @default(0)
  totalDeductionsMinor Int              @default(0)
  totalNetMinor        Int              @default(0)
  skippedEmployeeCount Int              @default(0)
  /// Phase 6 (SAPOK Pay integration) — separate from `status`, which is
  /// about whether the RUN'S NUMBERS are valid (COMPLETED/CANCELLED).
  /// This tracks whether the money has actually moved yet.
  disbursementStatus        PayrollDisbursementStatus @default(NOT_DISBURSED)
  /// SAPOK Pay's PayrollBatch.id, once a disbursement attempt has been made.
  disbursementBatchReference String?
  /// Incremented on every attempt (not just successful ones) — the
  /// idempotency key sent to SAPOK Pay includes this number specifically
  /// so a retry after fixing the underlying problem (e.g. funding the
  /// wallet) sends a NEW key and can actually succeed, instead of SAPOK
  /// Pay's own idempotency check replaying the first attempt's cached
  /// failure forever. A real bug caught in end-to-end testing, not a
  /// hypothetical — see docs/phase-6-payroll-disbursement.md.
  disbursementAttempts       Int      @default(0)
  createdById          String?
  createdAt            DateTime         @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organisationId, periodYear, periodMonth])
  @@index([organisationId])
  @@map("payroll_runs")
}

model Payslip {
  id                   String   @id @default(uuid())
  payrollRunId         String
  organisationId       String
  employeeId           String
  grossMinor           Int
  pensionMinor         Int      @default(0)
  payeMinor            Int      @default(0)
  otherDeductionsMinor Int      @default(0)
  netMinor             Int
  currency             String
  /// Computation trail for auditability: { annualGrossMajor, annualTaxableMajor, bandsApplied: [...] }
  breakdown            Json
  /// Null until a disbursement attempt has been made for this payslip.
  disbursementStatus         PayslipDisbursementStatus?
  disbursementFailureReason  String?
  createdAt            DateTime @default(now())

  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([organisationId])
  @@map("payslips")
}

enum DocumentCategory {
  IDENTIFICATION
  CONTRACT
  CERTIFICATE
  POLICY
  OTHER
}

/// Metadata-only — NEXORA doesn't run its own file storage yet, so `fileUrl`
/// is an external link the organisation manages itself (their own Drive/S3/
/// etc.), not an uploaded file. `employeeId` is optional: a document can
/// belong to a specific employee (an ID, a signed contract) or to the
/// organisation as a whole (a company policy).
model Document {
  id             String           @id @default(uuid())
  organisationId String
  employeeId     String?
  title          String
  category       DocumentCategory @default(OTHER)
  fileUrl        String
  expiryDate     DateTime?
  uploadedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee          Employee?          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy        OrganisationUser?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  complianceRecords ComplianceRecord[]

  @@index([organisationId])
  @@index([employeeId])
  @@map("documents")
}

enum ComplianceStatus {
  COMPLIANT
  PENDING
  EXPIRED
  NON_COMPLIANT
}

/// A trackable regulatory/policy obligation — a certification renewal, a
/// license, a mandatory training — optionally scoped to one employee or
/// left organisation-wide (`employeeId: null`). `documentId` optionally
/// links the evidence (e.g. the uploaded certificate) once satisfied.
model ComplianceRecord {
  id             String           @id @default(uuid())
  organisationId String
  employeeId     String?
  title          String
  description    String?
  status         ComplianceStatus @default(PENDING)
  dueDate        DateTime?
  completedDate  DateTime?
  documentId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([employeeId])
  @@map("compliance_records")
}

/// Refresh tokens are stored as a hash (never the raw token) so a leaked
/// database dump cannot be used to mint sessions. Rotation: each refresh
/// issues a new token and revokes the previous one via `revokedAt`.
model RefreshToken {
  id                 String    @id @default(uuid())
  jti                String    @unique
  tokenHash          String
  scope              AuthScope
  platformUserId     String?
  organisationId     String?
  organisationUserId String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  platformUser     PlatformUser?     @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  organisation     Organisation?     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationUser OrganisationUser? @relation(fields: [organisationUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([organisationUserId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only audit trail. actorId is deliberately NOT a foreign key: the
/// actor can be a platform user, an organisation user (Phase 4+), or a
/// background job/system process, each living in a different table (or no
/// table at all). actorType disambiguates which.
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  actorType      String?
  organisationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
