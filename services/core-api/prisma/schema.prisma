// NEXORA Core API — Prisma schema
//
// Phase 1 (Foundation): auth foundation + audit logging.
//   - PlatformUser   : identity for NEXORA Control Center operators.
//   - RefreshToken   : hashed, rotating refresh tokens for both auth scopes
//                      (platform now; organisation from Phase 4 onward).
//   - AuditLog       : generic append-only audit trail (section 58), used
//                      from the very first login event onward.
//
// Phase 2 (this change): platform RBAC + organisation management/onboarding.
//   - PlatformPermission / PlatformRole / PlatformRolePermission /
//     PlatformUserRole : the RBAC join promised in Phase 1 — permissions are
//     grouped into roles, roles are assigned to platform users (many-to-many
//     both ways, so a user can hold more than one role).
//   - Organisation    : the platform-managed shell record created during
//     onboarding. Subscriptions/billing (Phase 3) and organisation-side
//     auth/admin (Phase 4) attach to this later — this phase only owns
//     identity + lifecycle status.
//
// Phase 3 (this change): module + subscription engine.
//   - Module / PlanModule : a fixed catalog of feature modules (the business
//     modules Phase 5 actually builds — employees, payroll, etc.) and which
//     Plans include which modules. The catalog is seeded, not user-created,
//     since entries must correspond to real built features.
//   - Plan                : a purchasable tier (price + billing cycle +
//     included modules).
//   - Subscription        : one per Organisation, tracks the paid period and
//     lifecycle (TRIALING/ACTIVE → GRACE_PERIOD → SUSPENDED, or CANCELLED).
//     Status is stored but re-derived from dates on every read (see
//     SubscriptionsService.deriveEffectiveStatus) — there's no scheduler yet
//     to flip it automatically, so reads self-heal it instead.
//   - Invoice             : one per billing cycle charge attempt; a PAID
//     invoice doubles as the receipt (see Invoice.receiptNumber).
//   - Payments run through a swappable PaymentGateway interface — only a
//     MockPaymentGateway exists until the real integration is built.
//
// Every later phase ADDS models here — this file is never treated as final.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthScope {
  PLATFORM
  ORGANISATION
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum OrganisationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  ANNUALLY
}

/// GRACE_PERIOD and SUSPENDED are derived from dates, not set directly by
/// the API — see SubscriptionsService.deriveEffectiveStatus.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

model PlatformUser {
  id           String              @id @default(uuid())
  email        String              @unique
  passwordHash String
  firstName    String
  lastName     String
  status       PlatformUserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  refreshTokens         RefreshToken[]
  roles                 PlatformUserRole[]
  organisationsCreated  Organisation[]

  @@map("platform_users")
}

/// One platform-wide permission, e.g. "organisations:create". Permissions are
/// never assigned to users directly — only via a PlatformRole.
model PlatformPermission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  /// Groups permissions for UI display (e.g. "organisations", "platform_users").
  category    String
  createdAt   DateTime @default(now())

  roles PlatformRolePermission[]

  @@map("platform_permissions")
}

/// A named bundle of permissions assignable to platform users. isSystem roles
/// (seeded: SUPER_ADMIN, SUPPORT, FINANCE) can't be deleted via the API —
/// only their assignment to users changes.
model PlatformRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PlatformRolePermission[]
  users       PlatformUserRole[]

  @@map("platform_roles")
}

model PlatformRolePermission {
  roleId       String
  permissionId String

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("platform_role_permissions")
}

model PlatformUserRole {
  platformUserId String
  roleId         String
  assignedAt     DateTime @default(now())

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  role         PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([platformUserId, roleId])
  @@map("platform_user_roles")
}

/// The platform-managed shell record for a tenant organisation, created
/// during onboarding. Deliberately thin at this phase — no subscription,
/// billing or org-admin-account fields here; those attach in Phase 3/4.
model Organisation {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  status       OrganisationStatus @default(PENDING)
  contactEmail String
  contactPhone String?
  industry     String?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy     PlatformUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  subscription  Subscription?

  @@index([status])
  @@map("organisations")
}

/// A fixed catalog of feature modules — entries correspond 1:1 to real
/// business modules (Phase 5 onward), so this is seeded, not user-created.
model Module {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  plans PlanModule[]

  @@map("modules")
}

model Plan {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  /// Stored in minor currency units (e.g. kobo) to avoid float rounding.
  priceMinor   Int
  currency     String       @default("NGN")
  billingCycle BillingCycle
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules       PlanModule[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanModule {
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

/// One per Organisation (1:1 — an org has exactly one subscription at a
/// time; changing plans updates this row rather than creating a new one).
model Subscription {
  id                 String             @id @default(uuid())
  organisationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  gracePeriodEndsAt  DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  invoices     Invoice[]

  @@map("subscriptions")
}

/// A PAID invoice doubles as the receipt — see receiptNumber/paidAt.
model Invoice {
  id               String        @id @default(uuid())
  subscriptionId   String
  organisationId   String
  receiptNumber    String        @unique
  amountMinor      Int
  currency         String
  status           InvoiceStatus @default(PENDING)
  periodStart      DateTime
  periodEnd        DateTime
  paymentReference String?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([status])
  @@map("invoices")
}

/// Refresh tokens are stored as a hash (never the raw token) so a leaked
/// database dump cannot be used to mint sessions. Rotation: each refresh
/// issues a new token and revokes the previous one via `revokedAt`.
model RefreshToken {
  id             String    @id @default(uuid())
  jti            String    @unique
  tokenHash      String
  scope          AuthScope
  platformUserId String?
  organisationId String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  platformUser PlatformUser?  @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  organisation Organisation?  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only audit trail. actorId is deliberately NOT a foreign key: the
/// actor can be a platform user, an organisation user (Phase 4+), or a
/// background job/system process, each living in a different table (or no
/// table at all). actorType disambiguates which.
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  actorType      String?
  organisationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
